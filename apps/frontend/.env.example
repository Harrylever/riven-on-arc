# ==============================================================================
# Riven Frontend Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION
# ------------------------------------------------------------------------------
# PostgreSQL Database URL (used by Next.js API routes reading via @riven/shared)
DATABASE_URL="postgresql://user:password@host:5432/riven"
# Redis — same instance as the backend, see apps/backend/.env.example.
# Not wired into any frontend code yet (optional, for future response
# caching); replaces the old UPSTASH_REDIS_REST_* placeholders, which
# nothing ever referenced and used a different (REST-based) client than
# the ioredis/REDIS_URL convention actually adopted in packages/shared.
REDIS_URL=

# Arc RPC URL (used for on-demand token resolution when a token address is not found in DB)
ARC_RPC_URL="https://rpc.mainnet.arc.io"
NEXT_PUBLIC_CHAIN_MODE="arc"


# ------------------------------------------------------------------------------
# OPTIONAL / FEATURE UNLOCKS
# ------------------------------------------------------------------------------
# AI Agent (Product Phase 2 POST /api/agent/analyze)
ANTHROPIC_API_KEY=""
# Optional: model for Ask Riven rewrites (cheap + fast by default)
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Recommended: "claude-haiku-4-5-20251001" (fast & low cost) or "claude-sonnet-5" (in-depth)
AGENT_MODEL="claude-haiku-4-5-20251001"
# Optional AI voice for Ask Riven (it only rephrases Riven's own facts). Claude wins if both are set.
# Without either, Ask Riven answers from its rules engine.
GEMINI_API_KEY=""
# Google retires models quickly; the default is gemini-3.1-flash-lite.
# GEMINI_MODEL="gemini-3.1-flash-lite"
# Ask Riven daily limits: 10 questions for a wallet that signed in, 3 without, 30 per IP.
# Signs the wallet-session cookie and salts stored IP hashes. REQUIRED in production (>=16 chars,
# e.g. `openssl rand -base64 32`); without it wallet sign-in is off and everyone gets the 3/day tier.
ASK_SESSION_SECRET=""

# Development mock data mode (ignored automatically when VERCEL_ENV="production")
# Set to "true" to use offline sample token fixtures
USE_MOCK_DATA="false"

# Auth & Wallets. NOT USED: Riven is wallet-only and no code mounts Privy (see AGENTS.md, "Auth").
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# BubbleMaps (Product Phase 9 embedded iframe partner key)
NEXT_PUBLIC_BUBBLEMAPS_PARTNER_ID=""

# ------------------------------------------------------------------------------
# ADDED IN PHASE 1 (all read by frontend code)
# ------------------------------------------------------------------------------
# KOL feed (MadeOnSol). No fallback key in code: leave empty to disable the KOL tab.
MADEONSOL_API_KEY=""
# Shared secret required (x-score-secret header) by POST /api/score. Unset = route returns 401.
SCORE_API_SECRET=""
# Absolute base URL for server-side self-fetches (defaults to http://localhost:3000 / VERCEL_URL)
NEXT_PUBLIC_APP_URL=""

# Perps paper-trading terminal (/perps, /api/perp-signals). On unless "false":
# then the nav link is hidden, /perps 404s and the API returns without a DB query.
NEXT_PUBLIC_PERPS_ENABLED="true"
# Non-custodial buy/sell (user signs every tx). "false" ships a read-only Riven.
NEXT_PUBLIC_TRADING_ENABLED="false"
# Largest single trade (USD) the server will build a quote for. Default 250.
# TRADE_MAX_USDC=250
# Block range per eth_getLogs when looking up a token's pools. Public Arc RPCs refuse
# topic-filtered ranges over ~10k blocks; a paid RPC can raise this.
# ARC_TRADE_LOG_CHUNK_BLOCKS=9999
# Where "Dispute a score" links (form, X account…). Defaults to /methodology#disputes.
NEXT_PUBLIC_DISPUTE_URL=""

# Telegram alerts: the bot's username (without @). Leave empty to hide "Connect Telegram".
TELEGRAM_BOT_USERNAME=
