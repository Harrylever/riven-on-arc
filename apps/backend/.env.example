PORT=3001

# Postgres (Neon) — same DB as the frontend app
DATABASE_URL=postgres://user:password@host:5432/clawdex

# Legacy Solana settings remain required by the current Solana worker modules
# until those modules are replaced by the Arc implementation.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Arc read-only indexer and EVM inspection
CHAIN_MODE=arc
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Optional: first block for a fresh cursor (default: last ~24h, never before a factory deploy)
ARC_INDEX_START_BLOCK=
LOG_CHUNK_BLOCKS=9999
ARC_MAX_BLOCKS_PER_RUN=50000
CRON_SECRET=

# Launch detection (Phase 1)
# Must match the "authHeader" value used when registering the Helius webhook
HELIUS_WEBHOOK_SECRET=
# Base URL for ClawPump's public API — UNVERIFIED, see fixtures/helius-webhook-samples/README.md
CLAWPUMP_API_BASE_URL=
# Writes every received webhook payload to fixtures/helius-webhook-samples/ for parser validation
DEBUG_SAVE_WEBHOOK_PAYLOADS=false

# KOL ingestion (Phase 5) — provider is a runtime choice (AGENTS.md open
# decision #5 is still unresolved), not hardcoded. Leave both keys unset and
# it falls back to the mock provider automatically.
MADEONSOL_API_KEY=
SOLANA_TRACKER_API_KEY=
# "madeonsol" | "solana_tracker" | "mock" — overrides auto-selection when set
KOL_PROVIDER=
# Forces the mock provider regardless of the above (docs/BLUEPRINT.md's convention)
USE_MOCK_DATA=false

# Redis (Phase 8) — used for distributed rate limiting (@nestjs/throttler).
# Optional: if unset, falls back to throttler's built-in in-memory store,
# which is fine for a single-instance deploy. Either set REDIS_URL, or
# REDIS_HOST + REDIS_PORT as a fallback — see packages/shared/src/redis/config.ts.
REDIS_URL=
# REDIS_HOST=
# REDIS_PORT=

# Retention (Phase 8) — RetentionService deletes rows older than this from
# the highest-volume tables, daily. Default 30 if unset.
# DATA_RETENTION_DAYS=30

# Trade execution — DO NOT set these until the custody model decision is made
# (see AGENTS.md Open decisions: per-user wallet vs. pooled treasury)
# EXECUTION_WALLET_PRIVATE_KEY=

# ClawPump public API base (verified public: GET /api/tokens, /api/stats, /api/health, /api/leaderboard)
# CLAWPUMP_API_BASE_URL=https://clawpump.tech

# KOL callouts on the Riven home page (optional). X API v2 recent search needs
# a paid X API tier. Without these, callouts can still be added by hand:
#   POST /arc/callouts  (Authorization: Bearer $CRON_SECRET)
#   { "url": "https://x.com/<handle>/status/<id>", "author": "<handle>", "text": "...", "token": "0x..." }
X_BEARER_TOKEN=""
# Comma-separated X handles of the KOLs to follow, e.g. "ansem,blknoiz06"
X_KOL_HANDLES=""

# Telegram alerts (optional). Create a bot with @BotFather, paste its token here,
# and set the same bot's username as TELEGRAM_BOT_USERNAME in the frontend.
TELEGRAM_BOT_TOKEN=
# Public site URL used in Telegram message buttons.
RIVEN_SITE_URL=https://your-riven-domain
