{
  "name": "riven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:frontend": "bun run --filter frontend dev",
    "dev:backend": "bun run --filter backend dev",
    "build:shared": "bun run --filter @riven/shared build",
    "build": "bun run build:shared && bun run --filter frontend build",
    "test": "bun run --filter '*' test",
    "check-types": "bun run build:shared && bun run --filter '*' check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "railway": "^3.13.1",
    "typescript": "5.9.2"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/engines",
    "@reown/appkit",
    "bufferutil",
    "keccak",
    "prisma",
    "unrs-resolver",
    "utf-8-validate"
  ],
  "engines": {
    "bun": ">=1.4.0"
  }
}
